APP_NAME=RESIDENZA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,localhost

# Cloud Staging Example (Vercel Frontend + Render Backend + Neon PostgreSQL)
# APP_ENV=staging
# APP_DEBUG=false
# APP_URL=https://residenza-api.onrender.com
# FRONTEND_URL=https://residenza-v2.vercel.app
# SANCTUM_STATEFUL_DOMAINS=residenza-v2.vercel.app
# SESSION_SAME_SITE=none
# SESSION_SECURE_COOKIE=true

# Primary Target Database (PostgreSQL 15+ / Neon Serverless Postgres)
# Neon Organization: org-rough-rice-04633090 | Project: dry-star-13601902
# DB_CONNECTION=pgsql
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DB_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"
# DB_SSLMODE=require

# Local Development Fallback (SQLite)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=residenza-session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=residenza_cache

MEMCACHED_HOST=127.0.0.1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
